# HISTORYVERSE environment configuration
# Copy to .env.local and fill in what you need. EVERY variable is optional for local development:
# unset integrations report "not configured" and the rest of the platform keeps working.
# Never commit real secrets. Server-only values are never sent to the browser.

# --- Public (exposed to the browser) ---------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Runtime ---------------------------------------------------------------
LOG_LEVEL=info

# --- Database (Milestone 3) — PostgreSQL 16+ with pgvector -----------------
# With docker compose: postgresql://historyverse:historyverse_dev@127.0.0.1:5432/historyverse
DATABASE_URL=

# --- Authentication (Milestone 3, Better Auth) — generate with: openssl rand -base64 32
AUTH_SECRET=
# Scheduled publishing (Milestone 7): a scheduler calls POST /api/cron/publish with
# "Authorization: Bearer $CRON_SECRET" — generate with: openssl rand -base64 32
CRON_SECRET=
# Public origin of the running site, read at runtime (defaults to NEXT_PUBLIC_SITE_URL)
AUTH_URL=
# Extra origins allowed to call the auth API, comma-separated (e.g. preview deployments)
AUTH_TRUSTED_ORIGINS=
# Leave true. Only automated tests switch auth rate limiting off.
AUTH_RATE_LIMIT_ENABLED=true
# Optional Google sign-in for public users
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Background jobs (Milestone 8) ------------------------------------------
REDIS_URL=
# Keeps environments that share one Redis server apart (e.g. development and tests)
QUEUE_PREFIX=historyverse

# --- Media storage (Milestone 5/9): local | s3 ------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Historical sources (Milestone 4) ---------------------------------------
# Wikimedia requires a descriptive User-Agent with contact details:
# https://meta.wikimedia.org/wiki/User-Agent_policy
# e.g. HISTORYVERSE/0.1 (https://your-site.example/contact)
WIKIMEDIA_USER_AGENT=
# If outbound traffic must go through an HTTPS proxy, also set NODE_USE_ENV_PROXY=1 (Node >= 22.21)
# so the importer's requests use HTTPS_PROXY.
EUROPEANA_API_KEY=
SMITHSONIAN_API_KEY=
LOC_ENABLED=false

# --- Language model (Milestone 8): none | ollama | openai-compatible | anthropic | openai | gemini
AI_PROVIDER=none
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
# e.g. AI_PROVIDER=anthropic AI_MODEL=claude-opus-5-5, or AI_PROVIDER=ollama AI_MODEL=llama3.1 (free, local)
# Price per million tokens, used for cost estimates before any paid call. Built in for current
# Claude models; required for openai / openai-compatible (use 0 only for a free endpoint).
AI_INPUT_USD_PER_MTOK=
AI_OUTPUT_USD_PER_MTOK=
# Embeddings for semantic search: none | ollama | openai-compatible | openai | gemini
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=

# --- AI media (Milestones 9–11) --------------------------------------------
# Image reconstructions: none | openai | gemini | stability | comfyui
IMAGE_PROVIDER=none
IMAGE_API_KEY=
IMAGE_BASE_URL=
# Narration: none | piper | espeak (local, free) | openai | elevenlabs | google
TTS_PROVIDER=none
TTS_API_KEY=
TTS_BASE_URL=
# Optional AI video clips: none | runway | kling | google
VIDEO_GEN_PROVIDER=none
VIDEO_GEN_API_KEY=

# --- Video rendering (Milestone 11) ----------------------------------------
FFMPEG_PATH=ffmpeg

# --- YouTube (Milestone 12) ------------------------------------------------
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=

# --- Maps (Milestone 13) ---------------------------------------------------
MAP_STYLE_URL=

# --- Analytics (optional): none | plausible | posthog | google -------------
ANALYTICS_PROVIDER=none
ANALYTICS_KEY=

# --- Cost controls ---------------------------------------------------------
# Monthly USD ceiling for ALL billable providers combined. 0 means no paid calls are ever made.
AI_MONTHLY_BUDGET_USD=0

# Comma-separated integration ids to switch off, e.g. youtube,analytics
INTEGRATIONS_DISABLED=

# --- First administrator (used only by `pnpm admin:create`; do not keep in a file) ---
# ADMIN_EMAIL=  ADMIN_PASSWORD=  ADMIN_NAME=
